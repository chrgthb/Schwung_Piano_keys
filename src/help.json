{
  "title": "Piano Keys",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Pads become a piano",
        "keyboard and send",
        "MIDI notes, pressure",
        "and knob CCs.",
        "",
        "Rows 1+3: white keys",
        "Rows 2+4: black keys",
        "Pressed key: green"
      ]
    },
    {
      "title": "Channel",
      "lines": [
        "Track 1-4: select",
        " track, stays Auto",
        "Left/Right: select",
        " knob bank L / R",
        "Steps 1-16: toggle",
        " channels. All active",
        " ones get the notes",
        "",
        "Auto: channel of the",
        " track selected on",
        " Move"
      ]
    },
    {
      "title": "Screen & Jog",
      "lines": [
        "Jog turn: move the",
        " highlighted label",
        "Jog click: edit its",
        " value, click again",
        " to finish",
        "",
        "Channel: MIDI ch",
        "From: lowest note",
        "Prg: program change",
        " 0-127, sent on",
        " every change",
        "Out: output target",
        "AT: pressure mode",
        "",
        "Set: 0-9. While its",
        " value is active,",
        " Shift+Jog click",
        " names the Set (the",
        " whole name, up to",
        " 16 characters, is",
        " shown)"
      ]
    },
    {
      "title": "Octave & Output",
      "lines": [
        "Up/Down: octave",
        " (From moves by 12)",
        "",
        "Menu: black keys",
        " C# on pad 2 or 1",
        " (1: one more black)",
        "",
        "Out (jog): output",
        " Move / USB /",
        " Move+USB",
        "",
        "Move = Move tracks",
        "USB = USB-A device"
      ]
    },
    {
      "title": "Pressure",
      "lines": [
        "AT setting:",
        " Off",
        " Poly: key pressure",
        "  (default)",
        " Chan: channel",
        "  pressure",
        " CC1, CC2 .. CC127:",
        "  pressure as a CC"
      ]
    },
    {
      "title": "Knobs",
      "lines": [
        "Knobs 1-8 send CC",
        " 71-78 (bank L) or",
        " 79-86 (bank R)",
        "Left/Right: select",
        " the bank (L at start",
        " and after a Set",
        " change)",
        "Faster turn gives",
        " bigger steps",
        "",
        "",
        "Touch knob: opens",
        " the knob screen",
        " while it is held",
        " (and for 1 s after)",
        "Jog turn: Name / Ch",
        " / CC / Value row",
        "Jog click: edit the",
        " row ((editing) is",
        " shown); touch",
        " another knob to",
        " edit the same row",
        " there. Click or",
        " Back ends editing",
        "Name: jog click",
        " opens the keyboard",
        "Ch: Pad = the pad",
        " channels, or 1-16"
      ]
    },
    {
      "title": "Tips",
      "lines": [
        "Set Move tracks'",
        " MIDI In to their",
        " own channel 1-4",
        "for best results.",
        "",
        "Selecting channel",
        " 1-4 also selects the",
        " matching Move track",
        "",
        "CCs, program and",
        " pressure mode are",
        " saved and restored"
      ]
    },
    {
      "title": "Exit",
      "lines": [
        "Back: exit module",
        "",
        "Or: Shift + Volume",
        " touch + jog click",
        "",
        "Play/Record stay",
        " under Move control",
        "",
        "Capture/Undo go to",
        " Move only (not USB);",
        " the screen",
        " shows Capture sent",
        " (+tempo) / Undo sent",
        "",
        "Mute goes to Move",
        " only; Shift + Mute",
        " = all notes off",
        "",
        "Shift + X (Delete):",
        " reset the Set (name",
        " and values) to the",
        " default. Asks first:",
        " press Shift + X",
        " again to confirm,",
        " Back/jog cancels",
        "",
        "On the knob screen",
        " only that knob is",
        " reset (name, Ch,",
        " CC, value)"
      ]
    }
  ]
}
